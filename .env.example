# Copy this file to .env on the server (next to docker-compose.prod.yml) and fill in real values.
# Generate secrets with: openssl rand -hex 32

POSTGRES_PASSWORD=change-me
JWT_SECRET_KEY=change-me

# The origin (scheme + host + port, no trailing slash) that the browser sends
# as the frontend's Origin header -- must match exactly or CORS preflight
# requests get rejected with a 400. Comma-separate multiple origins.
FRONTEND_ORIGIN=http://100.78.45.17
